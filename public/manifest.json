{
  "manifest_version": 3,
  "name": "Capture Web Images",
  "version": "0.1.0",
  "description": "Captures every image loaded on a page and lets you filter, select, and download them as a ZIP.",
  "permissions": ["sidePanel", "storage"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "side_panel": {
    "default_path": "panel.html"
  },
  "action": {}
}
